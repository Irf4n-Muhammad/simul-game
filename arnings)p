    for (let i = 0; i < 8; i++) FC.pops.push({ x: it.x, y: it.y, vx: (Math.random() - 0.5) * 500 * FC.dpr, vy: (Math.random() - 0.7) * 450 * FC.dpr, r: (2.5 + Math.random() * 3.5) * FC.dpr, c, life: 0.5 });
  }
}
