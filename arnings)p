    ctx.fillStyle = "rgba(255,255,255,.45)"; ctx.fillRect(x + 5 * dpr, y - bh + 2.5 * dpr, Math.max(0, Math.min(w * 0.3, w - 10 * dpr)), 2.5 * dpr);
