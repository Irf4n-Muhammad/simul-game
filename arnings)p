      for (let i = 0; i < 14; i++) FC.pops.push({ x: it.x, y: it.y, vx: (Math.random() - 0.5) * 700 * FC.dpr, vy: (Math.random() - 0.8) * 600 * FC.dpr, r: (3 + Math.random() * 4) * FC.dpr, c: i % 2 ? "#3A3A3A" : "#F39A2E", life: 0.5 });
