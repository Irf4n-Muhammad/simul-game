// ---- Stack (v51): balok geser kiri-kanan, tap buat jatuhin; yang nggak numpuk kepotong. Sampai meleset total.
function stackInit() {
  const { cv } = FC, w = cv.width * 0.62;
  Object.assign(FC, { tower: [{ x: (cv.width - w) / 2, w }], cam: 0, perfect: 0, perfN: 0 });
  stackNew();
}
