  for (const p of FC.pops) { p.life -= dt; ctx.globalAlpha = Math.max(0, p.life / 0.9); ctx.fillStyle = p.c; ctx.fillText(p.txt, p.x, yOf(p.y) - bh * 2 - (0.9 - p.life) * 40 * dpr); }
